# Copie ce fichier en ".env" et remplis tes vrais identifiants.
# NE JAMAIS committer le fichier ".env" (ajoute-le au .gitignore).

SNOWFLAKE_ACCOUNT=xxxxx-xxxxx       # identifiant de compte, ex: ab12345.eu-west-1
SNOWFLAKE_USER=TON_USER
SNOWFLAKE_PASSWORD=TON_MOT_DE_PASSE
SNOWFLAKE_ROLE=SYSADMIN             # rôle avec droits suffisants pour créer DB/warehouse/roles
SNOWFLAKE_WAREHOUSE=COMPUTE_WH      # un warehouse existant pour exécuter les requêtes SnowDDL
